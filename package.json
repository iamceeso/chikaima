{
  "name": "chikaima",
  "version": "2.0.4",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint app components lib services store types --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:unit": "rm -rf .test-dist && tsc -p tsconfig.test.json && node --test .test-dist/tests/*.test.js",
    "test:coverage": "rm -rf .test-dist coverage && tsc -p tsconfig.test.json && node --test --experimental-test-coverage --test-coverage-exclude='.test-dist/tests/**' .test-dist/tests/*.test.js",
    "test": "npm run test:unit && npm run lint && npm run typecheck",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:unit && env NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL:-/api/v1} pnpm build && docker build -f Dockerfile --build-arg NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL:-/api/v1} -t ${CHIKAIMA_DOCKER_IMAGE_TAG:-chikaima-prepush} ."
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@napi-rs/canvas": "^0.1.80",
    "@tanstack/react-query": "^5.59.20",
    "@tanstack/react-query-devtools": "^5.59.20",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "jose": "^6.2.8",
    "jszip": "^3.10.1",
    "lucide-react": "^0.454.0",
    "mammoth": "^1.12.1",
    "next": "16.3.0",
    "pdf-parse": "^2.4.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.53.1",
    "sqlite-vec": "^0.1.9",
    "tailwind-merge": "^2.5.4",
    "tesseract.js": "^7.0.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.15.0",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@11.5.2+sha512.71c631e382066efc25625d5cf029075de07b61b37f6e27350fbd84b1bda5864c8c1967adc280776b45c30a715c0359a3be08fef42d5bb09e2b99029979692916"
}
