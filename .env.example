# Client/public settings
NEXT_PUBLIC_API_BASE_URL=/api/v1

# App settings
CHIKAIMA_APP_NAME=Chikaima
CHIKAIMA_APP_ENV=development

# Local persistence
CHIKAIMA_DB_PATH=./data/chikaima.db
CHIKAIMA_MEDIA_ROOT=./storage

# Auth and provider encryption
# For production, replace all three with real secrets:
#   openssl rand -hex 32
CHIKAIMA_JWT_SECRET_KEY=change-me-development-secret
CHIKAIMA_JWT_REFRESH_SECRET_KEY=change-me-too-development-secret
CHIKAIMA_PROVIDER_SECRET_KEY=replace-with-32-char-secret-key

# Token lifetimes
CHIKAIMA_ACCESS_TOKEN_EXPIRE_MINUTES=30
CHIKAIMA_REFRESH_TOKEN_EXPIRE_DAYS=7

# Upload limits, in megabytes
CHIKAIMA_DOCUMENT_UPLOAD_MAX_MEGABYTES=100
CHIKAIMA_AUDIO_UPLOAD_MAX_MEGABYTES=512
CHIKAIMA_VIDEO_UPLOAD_MAX_MEGABYTES=2048

# Retrieval/vector settings
CHIKAIMA_EMBEDDING_DIMENSION=384
CHIKAIMA_RAG_TOP_K=3

# Local model provider
CHIKAIMA_OLLAMA_BASE_URL=http://localhost:11434

# Provider catalog
# Optional JSON file that adds or overrides provider models without a code change
# (defaults to providers.json next to CHIKAIMA_DB_PATH). Format:
#   {"models": {"anthropic": [{"key": "model-id", "name": "Display name", "capabilities": {"chat": true}}]}}
# CHIKAIMA_PROVIDER_CATALOG_PATH=./data/providers.json
# "economy" (default) runs background summaries on a cheaper model from the default
# provider (e.g. a mini/haiku/flash model), falling back to the default model on error.
# "default" always uses the default model.
CHIKAIMA_BACKGROUND_MODEL_ROUTING=economy

# AI collaboration
# Every collaboration team works in a folder inside this directory; models can never
# read or write outside it. Point it at (or symlink projects into) where your code lives.
CHIKAIMA_COLLAB_ROOT=./data/workspaces
# Where agent and terminal commands run (tests, previews, deploys):
#   off    - no commands at all (default)
#   host   - as the Chikaima process user; NOT confined to the folder. Trusted machines only.
#   docker - one container per project with only its folder mounted, CPU/memory limited.
#            Needs the docker CLI and daemon (mount /var/run/docker.sock when Chikaima runs in Docker).
CHIKAIMA_COLLAB_EXEC=off
# CHIKAIMA_COLLAB_DOCKER_IMAGE=node:22-bookworm
# CHIKAIMA_COLLAB_DOCKER_MEMORY=2g
# CHIKAIMA_COLLAB_DOCKER_CPUS=2
# When Chikaima itself runs in a container: the host path of CHIKAIMA_COLLAB_ROOT (bind mounts use host paths).
# CHIKAIMA_COLLAB_HOST_ROOT=/home/me/chikaima/workspaces
# Ports handed out to live previews, and the host the server uses to reach them.
# CHIKAIMA_COLLAB_PREVIEW_PORT_START=4100
# CHIKAIMA_COLLAB_PREVIEW_PORT_END=4199
# CHIKAIMA_COLLAB_PREVIEW_HOST=127.0.0.1
# Chrome/Chromium for agent screenshots of the preview (auto-detected; set empty to disable).
# CHIKAIMA_CHROME_PATH=/usr/bin/chromium
